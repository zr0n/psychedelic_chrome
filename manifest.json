{
    "manifest_version": 3,
    "name": "Psychedelic Colors",
    "version": "1.0",
    "description": "Transforma todas as páginas em uma experiência psicodélica!",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }
  